# Copy to .env before running docker compose up.
DATABASE_URL=postgres://ridepool:ridepool@db:5432/ridepool
# Long random string, required. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
SEED_PASSWORD=password123
PORT=3000
LOG_LEVEL=info
NODE_ENV=production
